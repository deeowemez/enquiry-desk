# console_ro: SELECT on the stats_* views (schema/console_role.sql)
CONSOLE_DB_PASSWORD=change-me
REVIEW_BASE_URL=https://<your-n8n>/webhook/review
# console_facts: the ONLY write path, on fact_set (schema/console_roles_phase2.sql)
CONSOLE_FACTS_PASSWORD=change-me
# console_staging: reads the synthetic staging database for test runs
CONSOLE_STAGING_PASSWORD=change-me
# console_recheck: reads the text of a past enquiry so the server can re-send it to staging (never returned by the API)
CONSOLE_RECHECK_PASSWORD=change-me
# optional: CONSOLE_ALLOW_RECHECK=0 switches re-checks off; CONSOLE_READONLY=1 switches every write off
