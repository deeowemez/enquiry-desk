{
  "name": "enquiry-desk-console",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "CONSOLE_DB_HOST=${CONSOLE_DB_HOST:-127.0.0.1} tsx --env-file=.env --test server/api.test.ts server/facts.test.ts && node scripts/extract-prompts.mjs --check",
    "prompts": "node scripts/extract-prompts.mjs",
    "test:unit": "tsx --test server/facts.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@tanstack/react-query": "^5.104.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
