  {
   "id": 7,
   "type": "barchart",
   "title": "Enquiries per day, by outcome",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "enquiry-desk-pg"
   },
   "description": "Hong Kong calendar day. Action is set when a run finishes.",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 14,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "enquiry-desk-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select day::timestamp as time,\n sum(enquiries) filter (where action='auto_send') as \"auto-send\",\n sum(enquiries) filter (where action='clarify') as \"clarify\",\n sum(enquiries) filter (where action='escalate') as \"escalate\",\n sum(enquiries) filter (where action='blocked') as \"blocked\",\n sum(enquiries) filter (where status='failed') as \"failed\"\nfrom stats_daily where is_test in (${test:csv}) and $__timeFilter(day::timestamp) group by day order by day"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "xField": "time",
    "stacking": "normal",
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "xTickLabelRotation": -45
   }
  },
