  {
   "id": 5,
   "type": "stat",
   "title": "Avg cost / enquiry",
   "description": "Mean model spend per processed enquiry in the selected range.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "enquiry-desk-pg"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "enquiry-desk-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select coalesce(round(avg(cost_usd),5),0) as v from stats_enquiry where status='processed' and is_test in (${test:csv}) and $__timeFilter(received_at)"
    }
   ],
   "fieldConfig": {
    "defaults": {
