  {
   "id": 9,
   "type": "timeseries",
   "title": "Spend per day",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "enquiry-desk-pg"
   },
   "description": "Total model cost per Hong Kong day (bars) from run_log.",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "enquiry-desk-pg"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select day::timestamp as time, sum(total_cost_usd) as \"cost\" from stats_cost where is_test in (${test:csv}) and $__timeFilter(day::timestamp) group by day order by day"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
