      "fillOpacity": 70
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Waiting for a person",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "enquiry-desk-pg"
   },
   "description": "Oldest first. IDs only; open the review link from Telegram.",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "enquiry-desk-pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "select id, category, action, received_at, extract(epoch from waiting)::int as waiting from stats_pending_reviews where is_test in (${test:csv})"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "waiting"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     }
    ]
   },
   "options": {
    "sortBy": [
     {
      "displayName": "waiting",
      "desc": true
     }
    ]
   }
  }
 ]
